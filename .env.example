POSTGRES_IMAGE=postgres:19.0-trixie
POSTGRES_USER=postgres
# Задайте пароль в приватной копии шаблона.
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
PGBIND_PORT=5434

# Для существующей общей сети задайте её имя и POSTGRES_NETWORK_EXTERNAL=true.
POSTGRES_NETWORK=postgres-net
POSTGRES_NETWORK_EXTERNAL=false

POSTGRES_MEM_LIMIT=512m
POSTGRES_CPU_LIMIT=1.0
POSTGRES_SHM_SIZE=256mb
