# Шаблон переменных для развёртывания PostgreSQL.
# Это ЕДИНСТВЕННЫЙ файл с "env" в имени, который можно пушить в репозиторий — только с плейсхолдерами.
#
# Глобальное правило: в любой документации — только имена переменных, никогда значения.
# Реальные значения живут только локально на компе в файле `postgres.env`
# и попадают в стек единственным способом — при деплое через агента Portainer.

# Суперпользователь (POSTGRES_PASSWORD задаётся на ПУСТОЙ PGDATA — при первом старте)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=postgres

# Сеть: пусто = compose сам создаёт сеть `postgres-net`.
# Для подключения к существующей сети внешнего стека:
#   POSTGRES_NETWORK=<имя_сети>
#   POSTGRES_NETWORK_EXTERNAL=true
POSTGRES_NETWORK=
POSTGRES_NETWORK_EXTERNAL=false

# Порт: только loopback хоста (наружу недоступен). Для удалённого доступа — SSH-туннель.
POSTGRES_PORT_BIND=127.0.0.1:5432:5432

# Каталог данных: default `./data` (относительно compose) — локально.
# Через Portainer использовать АБСОЛЮТНЫЙ путь на хосте.
POSTGRES_DATA_DIR=

# Лимиты ресурсов под мощности сервера (переменные, не хардкод)
POSTGRES_MEM_LIMIT=512m
POSTGRES_CPU_LIMIT=1.0
POSTGRES_SHM_SIZE=256mb

# Тюнинг PG (передаётся через -c). Применяется всегда, безобиден на существующих данных.
PG_SHARED_BUFFERS=128MB
PG_MAX_CONNECTIONS=100

# Аргументы initdb — действуют только на пустой PGDATA
POSTGRES_INITDB_ARGS=--data-checksums
