# Шаблон переменных для развёртывания PostgreSQL.
# Это ЕДИНСТВЕННЫЙ файл с "env" в имени, который можно пушить в репозиторий — только с плейсхолдерами.
#
# Рабочие секреты храните в локальном env-файле вне Git или в файле пароля
# на Docker-хосте. Поля стека Portainer можно заполнить из локального env-файла.

# Суперпользователь (POSTGRES_PASSWORD задаётся на ПУСТОЙ PGDATA — при первом старте)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Путь ВНУТРИ контейнера. Требует отдельного read-only mount, см. README.
POSTGRES_PASSWORD_FILE=
POSTGRES_DB=postgres

# Образ: для новой БД используется версия из Compose. Для существующей укажите
# тег той же major-версии, что и PG_VERSION.
POSTGRES_IMAGE=

# Сеть: пусто = compose сам создаёт сеть `postgres-net`.
# Парадигма: сервер БД живёт на стабильной инфраструктурной сети (напр. db-net),
# а проекты подключаются к нему из СВОИХ compose-файлов (добавляют эту сеть к своим
# сервисам). Для существующей инфраструктурной сети:
#   POSTGRES_NETWORK=db-net
#   POSTGRES_NETWORK_EXTERNAL=true
POSTGRES_NETWORK=
POSTGRES_NETWORK_EXTERNAL=false

# Публикация на loopback хоста. Для удалённого доступа используйте SSH-туннель.
# Конвенция: стандартный хост-порт 5432 может быть занят другим стеком сервера,
# у отдельного PostgreSQL принято 127.0.0.1:5434:5432 (host 5434 → контейнер 5432).
POSTGRES_PORT_BIND=127.0.0.1:5434:5432

# Каталог данных: default `./data` (относительно compose) — локально.
# Для Portainer Agent задайте абсолютные пути на сервере без $HOME или ~.
# Оба каталога заранее должны существовать.
POSTGRES_DATA_DIR=
POSTGRES_INITDB_DIR=

# Лимиты ресурсов под мощности сервера (переменные, не хардкод)
POSTGRES_MEM_LIMIT=512m
POSTGRES_CPU_LIMIT=1.0
POSTGRES_SHM_SIZE=256mb

# Тюнинг PG (передаётся через -c). Согласуйте параметры с лимитом памяти контейнера.
PG_SHARED_BUFFERS=128MB
PG_MAX_CONNECTIONS=100

# Аргументы initdb — действуют только на пустой PGDATA
POSTGRES_INITDB_ARGS=--data-checksums

# Авто-создание БД при первом старте (пустой PGDATA): имена через пробел.
# Скрипт initdb/10-create-databases.sh выполняется только один раз, существующие данные не трогает.
INITDB_DATABASES=
